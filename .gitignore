# Data directory - ignore everything, then whitelist specific files
data/**
!data/checkpoints/
!data/checkpoints/*.ckpt
!data/checkpoints/README.md
!data/vocabularies/
# Only the antonym vocabulary is used in the paper.
!data/vocabularies/antonyms.csv
!data/datasets/
!data/datasets/synthclic/
!data/datasets/synthclic/synthclic_prompts.parquet
!data/datasets/synthbuster-plus/
!data/datasets/synthbuster-plus/synthbuster_plus_prompts.parquet

outputs/
logs/
wandb/
hf_cache/*

# Manuscript sources and the publication bundle: authored elsewhere, never part of the code release.
revision_data/

# Agent tooling
.claude/*
.agents/

# OS
.DS_Store
Thumbs.db

# experiments/data binary payload: fetched from HuggingFace and verified against
# experiments/data/manifest.json, never committed (the manifest + small CSV/parquet are).
reproduction/experiments/data/embeddings/
reproduction/experiments/data/projection/
reproduction/experiments/data/reference/
reproduction/experiments/data/checkpoints/

# Rendered figures are build outputs, not repository content: `make figures-all` regenerates them
# from the verified snapshot. The ledger, the exact plotted data (.csv) and the generated captions
# are tracked, so any number in a figure can be checked without the render.
reproduction/experiments/figures/**/*.pdf
reproduction/experiments/figures/**/*.png

# Raw run outputs (Tier 3): regenerated by the E-experiment drivers, never published.
results/
!results/.gitkeep

# Write-up bundle: a build output of `make package-revision`, not repository content.
revision_export/
revision_export.tar.gz
